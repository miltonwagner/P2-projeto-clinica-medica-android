rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function admin() {
      return logado() && request.auth.token.admin == true;
    }

    function medicoAutorizado() {
      return logado()
        && exists(/databases/$(database)/documents/medicos/$(request.auth.uid))
        && get(/databases/$(database)/documents/medicos/$(request.auth.uid)).data.autorizado == true;
    }

    // Paciente lê/edita o próprio cadastro; médico autorizado e admin podem ler.
    match /pacientes/{userId} {
      allow read: if logado() && (request.auth.uid == userId || medicoAutorizado() || admin());
      allow create, update: if logado() && request.auth.uid == userId;
      allow delete: if admin();
    }

    // Login consulta medicos/{uid} para definir o perfil; só admin cadastra/autoriza.
    // O próprio médico só pode alterar o status "online" e a apresentação (bio).
    match /medicos/{medicoId} {
      allow read: if logado();
      allow create, delete: if admin();
      allow update: if admin()
        || (logado() && request.auth.uid == medicoId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online', 'bio']));
    }

    // Prontuário: anotações visíveis e editáveis apenas pelo médico que as criou.
    match /anotacoes/{doc} {
      allow read, update, delete: if medicoAutorizado() && resource.data.medicoId == request.auth.uid;
      allow create: if medicoAutorizado() && request.resource.data.medicoId == request.auth.uid;
    }

    // Agenda precisa ver horários ocupados de todos os pacientes.
    match /agendamentos/{doc} {
      allow read, write: if logado();
    }

    match /usuarios/{userId} {
      allow read, write: if logado() && request.auth.uid == userId;
    }
  }
}
