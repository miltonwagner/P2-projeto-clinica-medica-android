    <activity
        android:name=".MainActivity"
        android:exported="false" />

    <activity
        android:name=".EnderecoActivity"
        android:exported="false" />

    <activity
        android:name=".ListaConsultasActivity"
        android:exported="false" />

    <activity
        android:name=".ListaConsultasMedicoActivity"
        android:exported="false" />

    <activity
        android:name=".ConsultasActivity"
        android:exported="false" />

    <activity
        android:name=".RevisaoAgendamentoActivity"
        android:exported="false" />

    <activity
        android:name=".AgendamentoSucessoActivity"
        android:exported="false" />

    <activity
        android:name=".AdminMedicosActivity"
        android:exported="false" />
    <activity
        android:name=".PerfilActivity"
        android:exported="false" />

        <activity
            android:name=".MarketplaceActivity"
            android:exported="false" />
        <activity
            android:name=".PerfilMedicoActivity"
