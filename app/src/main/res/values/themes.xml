<resources>
    <style name="Base.Theme.ClinicaVidaPlus" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primaria</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primaria_clara</item>
        <item name="colorOnPrimaryContainer">@color/primaria_escura</item>
        <item name="colorSecondaryContainer">@color/primaria_clara</item>
        <item name="colorOnSecondaryContainer">@color/primaria_escura</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto_escuro</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:textColorHint">@color/texto_claro</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/superficie</item>
        <!-- Mantém Button como AppCompatButton para respeitar os fundos próprios. -->
        <item name="viewInflaterClass">androidx.appcompat.app.AppCompatViewInflater</item>
    </style>

    <style name="Theme.ClinicaVidaPlus" parent="Base.Theme.ClinicaVidaPlus" />
    <!-- Tela de passagem da videochamada (pede câmera/microfone e abre o Jitsi). -->
    <style name="Theme.ClinicaVidaPlus.Transparente" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
