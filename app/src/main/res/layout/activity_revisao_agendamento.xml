<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/btnVoltarRevisao"
            style="@style/Botao.Voltar"
            android:layout_marginStart="-4dp" />

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Confirme sua consulta" />

        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Confira os dados antes de finalizar o agendamento." />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/Texto.Pequeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Médico" />

            <TextView
                android:id="@+id/txtRevisaoMedico"
                style="@style/Texto.CardTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <TextView
                style="@style/Texto.Pequeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Especialidade" />

            <TextView
                android:id="@+id/txtRevisaoEspecialidade"
                style="@style/Texto.CardTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/borda" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Pequeno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data" />

                    <TextView
                        android:id="@+id/txtRevisaoData"
                        style="@style/Texto.CardTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawableStart="@drawable/ic_nav_consultas"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Pequeno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Horário" />

                    <TextView
                        android:id="@+id/txtRevisaoHorario"
                        style="@style/Texto.CardTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawableStart="@drawable/ic_relogio"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnConfirmarRevisao"
            style="@style/Botao.Primario"
            android:layout_marginTop="24dp"
            android:text="Confirmar agendamento" />

        <TextView
            style="@style/Texto.Pequeno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Você poderá acompanhar a consulta em Minhas consultas." />
    </LinearLayout>
</ScrollView>
