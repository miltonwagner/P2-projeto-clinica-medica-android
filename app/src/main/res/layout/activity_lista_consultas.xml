<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6">

    <Button
        android:id="@+id/btnVoltarLista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← VOLTAR"
        android:layout_margin="16dp"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/btnVoltarLista"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Último Agendamento"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1d8f8a"
            app:cardCornerRadius="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtResumoMedico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Médico: ---"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtResumoEspecialidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Especialidade: ---"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/txtResumoDataHora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data e Hora: ---"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#55FFFFFF"
                    android:layout_marginVertical="10dp"/>

                <TextView
                    android:id="@+id/txtDiagnostico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diagnóstico: Aguardando avaliação médica"
                    android:textColor="#FFEB3B"
                    android:textStyle="italic" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#212529">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clínica VidaPlus - Unidade Indaiatuba"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>
</RelativeLayout>

