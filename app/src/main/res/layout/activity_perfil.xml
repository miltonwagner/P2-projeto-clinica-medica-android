<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Texto.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Perfil" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/txtAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/primaria"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPerfilNome"
                    style="@style/Texto.Secao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Carregando..."
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/txtPerfilEmail"
                    style="@style/Texto.Subtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtPerfilTipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_badge_info"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/primaria_escura"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerPerfilInfo"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSairConta"
                style="@style/Botao.Perigo"
                android:layout_marginTop="20dp"
                android:drawableStart="@drawable/ic_sair"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Sair da conta" />

            <TextView
                style="@style/Texto.Pequeno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/nome_clinica" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/divisorNavInferior"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navInferior"
        style="@style/NavInferior" />
</LinearLayout>
