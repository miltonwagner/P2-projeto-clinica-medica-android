<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/btnVoltarSucesso"
            style="@style/Botao.Voltar"
            android:layout_gravity="start"
            android:layout_marginStart="-4dp" />

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_badge_sucesso"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/sucesso"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Consulta agendada!" />

        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Seu agendamento foi salvo com sucesso." />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/Texto.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resumo da consulta"
                android:textColor="@color/texto_cinza" />

            <TextView
                android:id="@+id/txtSucessoResumo"
                style="@style/Texto.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnVerMinhasConsultas"
            style="@style/Botao.Primario"
            android:layout_marginTop="24dp"
            android:text="Ver minhas consultas" />

        <Button
            android:id="@+id/btnNovoAgendamentoSucesso"
            style="@style/Botao.Contorno"
            android:layout_marginTop="12dp"
            android:text="Novo agendamento" />
    </LinearLayout>
</ScrollView>
