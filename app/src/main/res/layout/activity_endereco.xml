<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btnVoltarEnd"
                style="@style/Botao.Voltar"
                android:layout_marginStart="-4dp" />

            <TextView
                style="@style/Texto.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nossa clínica" />

            <TextView
                style="@style/Texto.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Estamos prontos para receber você." />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="16dp"
                android:contentDescription="Foto da Clínica Médica Vida Plus"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_clinica_vidaplus"
                app:shapeAppearanceOverlay="@style/FormaArredondada" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    style="@style/Texto.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Endereço"
                    android:textColor="@color/texto_cinza" />

                <TextView
                    style="@style/Texto.CardTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawableStart="@drawable/ic_nav_clinica"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="Rua Bernardino de Campos, 933" />

                <TextView
                    style="@style/Texto.Corpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="2dp"
                    android:text="Centro, Indaiatuba - SP\nCEP: 13330-010" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/borda" />

                <TextView
                    style="@style/Texto.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contato"
                    android:textColor="@color/texto_cinza" />

                <TextView
                    style="@style/Texto.Corpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Telefone: (19) 99348-4567" />

                <TextView
                    style="@style/Texto.Corpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="E-mail: clinica@gmail.com" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAbrirMaps"
                style="@style/Botao.Primario"
                android:layout_marginTop="20dp"
                android:text="Como chegar" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/divisorNavInferior"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navInferior"
        style="@style/NavInferior" />
</LinearLayout>
