<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:fillViewport="true"
    android:background="#F5F6F8">

    <androidx.constraintlayout.widget.ConstraintLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:padding="24dp">


        <!-- LOGO -->

        <ImageView
            android:id="@+id/imgLogoRecuperacao"

            android:layout_width="100dp"
            android:layout_height="100dp"

            android:layout_marginTop="40dp"

            android:src="@drawable/image_removebg_preview"

            android:scaleType="fitCenter"

            android:contentDescription="@string/app_name"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- TÍTULO -->

        <TextView
            android:id="@+id/txtTituloRecuperacao"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:text="Recuperar senha"

            android:textColor="#1A1A1A"

            android:textSize="24sp"

            android:textStyle="bold"

            app:layout_constraintTop_toBottomOf="@id/imgLogoRecuperacao"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent" />


        <!-- SUBTÍTULO -->

        <TextView
            android:id="@+id/txtDescricaoRecuperacao"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:gravity="center"

            android:text="Digite seu e-mail e enviaremos as instruções para recuperar sua senha."

            android:textColor="#8A8A8A"

            android:textSize="14sp"

            app:layout_constraintTop_toBottomOf="@id/txtTituloRecuperacao"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent" />


        <!-- CARD -->

        <androidx.constraintlayout.widget.ConstraintLayout

            android:id="@+id/cardRecuperacao"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="32dp"

            android:background="@drawable/bg_card"

            android:elevation="8dp"

            android:padding="20dp"

            app:layout_constraintTop_toBottomOf="@id/txtDescricaoRecuperacao"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent">


            <!-- LABEL -->

            <TextView
                android:id="@+id/lblEmailRecuperacao"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="E-mail"

                android:textColor="#4A4A4A"

                android:textSize="13sp"

                app:layout_constraintTop_toTopOf="parent"

                app:layout_constraintStart_toStartOf="parent" />


            <!-- E-MAIL -->

            <EditText
                android:id="@+id/edtEmailRecuperacao"

                android:layout_width="0dp"
                android:layout_height="52dp"

                android:layout_marginTop="6dp"

                android:background="@drawable/bg_input_field"

                android:hint="seu@email.com"

                android:inputType="textEmailAddress"

                android:paddingStart="14dp"

                android:paddingEnd="14dp"

                android:textSize="14sp"

                app:layout_constraintTop_toBottomOf="@id/lblEmailRecuperacao"

                app:layout_constraintStart_toStartOf="parent"

                app:layout_constraintEnd_toEndOf="parent" />


            <!-- BOTÃO -->

            <Button
                android:id="@+id/btnEnviarRecuperacao"

                android:layout_width="0dp"

                android:layout_height="52dp"

                android:layout_marginTop="20dp"

                android:background="@drawable/bg_button_primary"

                android:text="Enviar instruções"

                android:textAllCaps="false"

                android:textColor="#FFFFFF"

                android:textSize="16sp"

                android:textStyle="bold"

                app:layout_constraintTop_toBottomOf="@id/edtEmailRecuperacao"

                app:layout_constraintStart_toStartOf="parent"

                app:layout_constraintEnd_toEndOf="parent" />


            <!-- VOLTAR -->

            <TextView
                android:id="@+id/txtVoltarLogin"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                android:clickable="true"

                android:focusable="true"

                android:text="Voltar para o login"

                android:textColor="#3D6BFF"

                android:textSize="13sp"

                app:layout_constraintTop_toBottomOf="@id/btnEnviarRecuperacao"

                app:layout_constraintStart_toStartOf="parent"

                app:layout_constraintEnd_toEndOf="parent"

                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
