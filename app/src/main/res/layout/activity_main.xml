<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Barra superior com botão Voltar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <Button
            android:id="@+id/btnVoltarCadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← VOLTAR"
            android:backgroundTint="#1a8c7f"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Conteúdo rolável -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="30dp"
            android:gravity="center">

            <!-- Logo -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/logomed"
                android:layout_marginBottom="20dp" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cadastro de Paciente"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1a8c7f"
                android:layout_marginBottom="20dp"/>

            <!-- Campo Nome -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editNomeCadastro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Digite seu nome"
                android:inputType="textPersonName|textCapWords"
                android:padding="10dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="15dp" />

            <!-- Campo Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editEmailCadastro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Digite seu email"
                android:inputType="textEmailAddress"
                android:padding="10dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="15dp" />

            <!-- Campo Telefone -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Telefone"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editTelefoneCadastro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Digite seu telefone"
                android:inputType="phone"
                android:padding="10dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="15dp" />

            <!-- Campo Data de Nascimento -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data de Nascimento"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editNascimentoCadastro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="dd/mm/aaaa"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:padding="10dp"
                android:background="@android:drawable/editbox_background"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:layout_marginBottom="15dp" />

            <!-- Campo Senha -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Senha"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editSenhaCadastro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Crie uma senha (mín. 6 dígitos)"
                android:inputType="textPassword"
                android:padding="10dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="25dp" />

            <!-- Botão Cadastrar -->
            <Button
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="FINALIZAR CADASTRO"
                android:backgroundTint="#1a8c7f"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
