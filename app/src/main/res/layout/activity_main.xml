<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/btnVoltarCadastro"
            style="@style/Botao.Voltar"
            android:layout_marginStart="-4dp" />

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Criar conta" />

        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Preencha seus dados para agendar consultas." />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/Texto.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome completo" />

            <EditText
                android:id="@+id/editNomeCadastro"
                style="@style/Campo"
                android:layout_marginTop="6dp"
                android:autofillHints="name"
                android:hint="Seu nome"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/Texto.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="E-mail" />

            <EditText
                android:id="@+id/editEmailCadastro"
                style="@style/Campo"
                android:layout_marginTop="6dp"
                android:autofillHints="emailAddress"
                android:hint="seu@email.com"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/Texto.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Telefone / WhatsApp" />

            <EditText
                android:id="@+id/editTelefoneCadastro"
                style="@style/Campo"
                android:layout_marginTop="6dp"
                android:autofillHints="phone"
                android:hint="(00) 00000-0000"
                android:inputType="phone" />

            <TextView
                style="@style/Texto.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Data de nascimento" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editNascimentoCadastro"
                    style="@style/Campo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="DD/MM/AAAA"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="10" />

                <ImageButton
                    android:id="@+id/btnCalendarioNascimento"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_botao_secundario"
                    android:contentDescription="Abrir calendário de nascimento"
                    android:scaleType="center"
                    android:src="@drawable/ic_nav_consultas" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtLabelSenhaCadastro"
                style="@style/Texto.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Senha" />

            <EditText
                android:id="@+id/editSenhaCadastro"
                style="@style/Campo"
                android:layout_marginTop="6dp"
                android:autofillHints="newPassword"
                android:hint="Mínimo 6 caracteres"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnCadastrar"
                style="@style/Botao.Primario"
                android:layout_marginTop="24dp"
                android:text="Criar conta" />
        </LinearLayout>

        <TextView
            style="@style/Texto.Pequeno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/nome_clinica" />
    </LinearLayout>
</ScrollView>
