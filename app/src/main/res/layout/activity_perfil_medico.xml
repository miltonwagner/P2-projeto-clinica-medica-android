<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btnVoltarPerfilMedico"
                style="@style/Botao.Voltar"
                android:layout_marginStart="-4dp" />

            <TextView
                android:id="@+id/txtAvatarMedico"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:textColor="@color/primaria_escura"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNomeMedico"
                style="@style/Texto.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtCrmMedico"
                style="@style/Texto.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtAvaliacaoMedico"
                style="@style/Texto.Corpo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_estrela"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEspecialidadeTag"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tag"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/primaria_escura"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Texto.Secao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Sobre" />

            <TextView
                android:id="@+id/txtBioMedico"
                style="@style/Texto.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/texto_cinza" />

            <TextView
                style="@style/Texto.Secao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Atendimento" />

            <LinearLayout
                android:id="@+id/containerPlanosMedico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                style="@style/Texto.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/ic_local"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/endereco_clinica" />

            <Button
                android:id="@+id/btnAgendarComMedico"
                style="@style/Botao.Primario"
                android:layout_marginTop="24dp"
                android:text="Agendar consulta" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/divisorNavInferior"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navInferior"
        style="@style/NavInferior" />
</LinearLayout>
