<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btnVoltarAgendar"
                style="@style/Botao.Voltar"
                android:layout_marginStart="-4dp" />

            <TextView
                style="@style/Texto.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Agendar Consulta" />

            <TextView
                android:id="@+id/txtMedicoAgendar"
                style="@style/Texto.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center" />

            <!-- Modo de atendimento -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    style="@style/Texto.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo de atendimento" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnModoOnline"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pilula"
                        android:drawableStart="@drawable/ic_video"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Online"
                        android:textColor="@color/pilula_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnModoPresencial"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pilula"
                        android:drawableStart="@drawable/ic_local"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Presencial"
                        android:textColor="@color/pilula_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDetalheModo"
                    style="@style/Texto.Pequeno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Calendário -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Texto.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Escolha o dia" />

                    <TextView
                        android:id="@+id/btnMesAnterior"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="@color/texto_escuro"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/txtMesAgendar"
                        style="@style/Texto.CardTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="120dp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/btnMesSeguinte"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="@color/texto_escuro"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerCalendario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Horário -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <TextView
                    style="@style/Texto.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Horário" />

                <LinearLayout
                    android:id="@+id/containerHorarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtAvisoHorarios"
                    style="@style/Texto.Pequeno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Escolha um dia para ver os horários livres." />
            </LinearLayout>

            <!-- Seus dados -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <TextView
                    style="@style/Texto.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seus dados" />

                <TextView
                    style="@style/Texto.Pequeno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Nome completo" />

                <EditText
                    android:id="@+id/edtNomeAgendar"
                    style="@style/Campo"
                    android:layout_marginTop="6dp"
                    android:autofillHints="name"
                    android:hint="Seu nome"
                    android:inputType="textPersonName|textCapWords" />

                <TextView
                    style="@style/Texto.Pequeno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="E-mail" />

                <EditText
                    android:id="@+id/edtEmailAgendar"
                    style="@style/Campo"
                    android:layout_marginTop="6dp"
                    android:autofillHints="emailAddress"
                    android:hint="seu@email.com"
                    android:inputType="textEmailAddress" />

                <TextView
                    style="@style/Texto.Pequeno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Telefone / WhatsApp" />

                <EditText
                    android:id="@+id/edtTelefoneAgendar"
                    style="@style/Campo"
                    android:layout_marginTop="6dp"
                    android:autofillHints="phone"
                    android:hint="(00) 00000-0000"
                    android:inputType="phone" />

                <TextView
                    style="@style/Texto.Pequeno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Motivo (opcional)" />

                <EditText
                    android:id="@+id/edtMotivoAgendar"
                    style="@style/Campo"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints=""
                    android:gravity="top"
                    android:hint="Descreva brevemente o que te trouxe aqui..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="88dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:singleLine="false" />
            </LinearLayout>

            <Button
                android:id="@+id/btnConfirmarAgendar"
                style="@style/Botao.Primario"
                android:layout_marginTop="20dp"
                android:text="Confirmar Agendamento" />

            <TextView
                android:id="@+id/txtRodapeAgendar"
                style="@style/Texto.Pequeno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Pagamento feito na clínica, no dia da consulta" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/divisorNavInferior"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navInferior"
        style="@style/NavInferior" />
</LinearLayout>
