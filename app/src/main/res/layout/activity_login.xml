<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/btnVoltarLogin"
            style="@style/Botao.Voltar"
            android:layout_marginStart="-4dp" />

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_icone_marca">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_marca" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtTitulo"
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="@string/login_titulo" />

        <TextView
            android:id="@+id/txtSubtitulo"
            style="@style/Texto.Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/login_subtitulo" />

        <LinearLayout
            android:id="@+id/cardLogin"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/lblEmail"
                style="@style/Texto.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_label_email" />

            <EditText
                android:id="@+id/edtEmail"
                style="@style/Campo"
                android:layout_marginTop="6dp"
                android:autofillHints="emailAddress"
                android:hint="@string/login_hint_email"
                android:inputType="textEmailAddress" />

            <TextView
                android:id="@+id/lblSenha"
                style="@style/Texto.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/login_label_senha" />

            <EditText
                android:id="@+id/edtSenha"
                style="@style/Campo"
                android:layout_marginTop="6dp"
                android:autofillHints="password"
                android:hint="@string/login_hint_senha"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/txtEsqueceuSenha"
                style="@style/Texto.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/login_esqueceu_senha" />

            <Button
                android:id="@+id/btnEntrar"
                style="@style/Botao.Primario"
                android:layout_marginTop="12dp"
                android:text="@string/login_botao_entrar" />

            <TextView
                android:id="@+id/txtOu"
                style="@style/Texto.Pequeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:text="@string/login_ou" />

            <Button
                android:id="@+id/btnGoogle"
                style="@style/Botao.Contorno"
                android:layout_marginTop="14dp"
                android:text="@string/login_botao_google" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCadastro"
            style="@style/Texto.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/login_cadastro" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <TextView
            android:id="@+id/txtRodapeClinica"
            style="@style/Texto.Pequeno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/nome_clinica" />
    </LinearLayout>
</ScrollView>
