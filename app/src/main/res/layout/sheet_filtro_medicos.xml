<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/borda" />

    <TextView
        style="@style/Texto.Secao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Filtros" />

    <TextView
        style="@style/Texto.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ordenar por" />

    <RadioGroup
        android:id="@+id/grupoOrdenacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <RadioButton
            android:id="@+id/ordemRelevancia"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:buttonTint="@color/primaria"
            android:text="Relevância"
            android:textColor="@color/texto_escuro" />

        <RadioButton
            android:id="@+id/ordemAvaliacao"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:buttonTint="@color/primaria"
            android:text="Melhor avaliação"
            android:textColor="@color/texto_escuro" />

        <RadioButton
            android:id="@+id/ordemMenorPreco"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:buttonTint="@color/primaria"
            android:text="Menor preço"
            android:textColor="@color/texto_escuro" />
    </RadioGroup>

    <Button
        android:id="@+id/btnAplicarFiltro"
        style="@style/Botao.Primario"
        android:layout_marginTop="16dp"
        android:text="Aplicar" />

    <Button
        android:id="@+id/btnLimparFiltro"
        style="@style/Botao.Contorno"
        android:layout_marginTop="10dp"
        android:text="Limpar filtros" />
</LinearLayout>
