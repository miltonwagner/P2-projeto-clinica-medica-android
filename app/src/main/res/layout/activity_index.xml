<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Cabeçalho -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/txtTituloClinica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Clínica Saúde e Cidadania"
            android:textColor="#17365D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="2" />

    </RelativeLayout>

    <!-- Conteúdo principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:background="#FFFFFF">

            <!-- Imagem da clínica -->
            <ImageView
                android:id="@+id/imgFoto"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginBottom="16dp"
                android:scaleType="fitCenter"
                android:contentDescription="Foto da Clínica Médica Vida Plus"
                android:src="@drawable/foto_clinica_vidaplus" />

            <!-- Apresentação -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Como podemos ajudar?"
                android:textColor="#17365D"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acesse nossos serviços de forma simples e rápida."
                android:textColor="#60758D"
                android:textSize="15sp"
                android:layout_marginBottom="22dp" />

            <!-- Botão Login -->
            <Button
                android:id="@+id/btnIrLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:padding="12dp"
                android:text="LOGIN"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/bg_home_login"
                android:stateListAnimator="@null" />

            <!-- Botão Cadastro -->
            <Button
                android:id="@+id/btnIrCadastro"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:padding="12dp"
                android:text="CADASTRO"
                android:textColor="#174A7E"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/bg_home_cadastro"
                android:stateListAnimator="@null" />

            <!-- Botão Nossa Localização -->
            <Button
                android:id="@+id/btnVerEndereco"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:padding="12dp"
                android:text="NOSSA LOCALIZAÇÃO"
                android:textColor="#174A7E"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/bg_home_localizacao"
                android:stateListAnimator="@null" />

            <!-- Botão Sair: agora abaixo da localização -->
            <Button
                android:id="@+id/btnSairApp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="2dp"
                android:padding="12dp"
                android:text="SAIR"
                android:textColor="#174A7E"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_home_localizacao"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>

    <!-- Rodapé -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#17365D"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R. Bernardino de Campos, 933 - Centro, Indaiatuba - SP"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="#6686A8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2026 Clínica Médica Vida Plus"
            android:textColor="#D7E5F5"
            android:gravity="center"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
