<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Texto.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Visão geral" />

            <TextView
                android:id="@+id/txtBoasVindasMedico"
                style="@style/Texto.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Carregando..." />

            <LinearLayout
                android:id="@+id/cardStatusOnline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_status_offline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:id="@+id/indicadorOnline"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_ponto_offline" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtStatusOnline"
                        style="@style/Texto.CardTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Você está offline" />

                    <TextView
                        android:id="@+id/txtStatusOnlineDetalhe"
                        style="@style/Texto.Pequeno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ative para aparecer como atendendo no app" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchOnline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerEstatisticas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <TextView
                style="@style/Texto.Secao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Aguardando confirmação" />

            <LinearLayout
                android:id="@+id/containerPendentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                style="@style/Texto.Secao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Próximas consultas" />

            <LinearLayout
                android:id="@+id/containerProximas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/divisorNavInferior"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navInferior"
        style="@style/NavInferior" />
</LinearLayout>
